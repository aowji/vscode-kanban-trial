{
  "name": "markdown-kanban",
  "displayName": "Markdown Kanban",
  "description": "Show the Markdown files of a folder as a GitLab-style issue board. Card status lives in a *.kb.yaml board file, so your documents are never modified.",
  "version": "0.2.0",
  "license": "MIT",
  "publisher": "markdown-kanban",
  "repository": {
    "type": "git",
    "url": "https://github.com/aowji/vscode-kanban-trial.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "kanban",
    "board",
    "yaml",
    "custom-editor",
    "issues"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownKanban.board",
        "displayName": "Kanban Board",
        "selector": [
          {
            "filenamePattern": "*.kb.yaml"
          },
          {
            "filenamePattern": "*.kb.yml"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "markdownKanban.openBoard",
        "title": "Open Board",
        "category": "Markdown Kanban",
        "icon": "$(project)"
      },
      {
        "command": "markdownKanban.openAsText",
        "title": "Open Board File as Text (YAML)",
        "category": "Markdown Kanban",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markdownKanban.createBoardFile",
        "title": "Create Board File",
        "category": "Markdown Kanban",
        "icon": "$(new-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownKanban.openBoard",
          "when": "resourceFilename =~ /\\.kb\\.ya?ml$/i && activeCustomEditorId != markdownKanban.board",
          "group": "navigation"
        },
        {
          "command": "markdownKanban.openAsText",
          "when": "resourceFilename =~ /\\.kb\\.ya?ml$/i && activeCustomEditorId == markdownKanban.board",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownKanban.openBoard"
        },
        {
          "command": "markdownKanban.openAsText",
          "when": "resourceFilename =~ /\\.kb\\.ya?ml$/i"
        },
        {
          "command": "markdownKanban.createBoardFile"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Kanban",
      "properties": {
        "markdownKanban.defaultLists": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Lists written into a new board file, and used as the fallback when a board file has no `lists` key. Empty by default, so a new board only shows the No status list. A list is just the tag its cards carry, shown verbatim (e.g. `in-progress`)."
        },
        "markdownKanban.excludeDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            ".hg",
            ".svn",
            "dist",
            "out",
            "build",
            "coverage",
            ".venv",
            "venv",
            "__pycache__",
            "target",
            "vendor",
            ".next",
            ".nuxt",
            ".idea",
            ".vscode"
          ],
          "description": "Directory names that are not scanned for Markdown files."
        },
        "markdownKanban.sortBy": {
          "type": "string",
          "enum": [
            "updated",
            "title"
          ],
          "default": "updated",
          "description": "How cards are ordered inside a list."
        },
        "markdownKanban.openMode": {
          "type": "string",
          "enum": [
            "beside",
            "activeTab"
          ],
          "default": "beside",
          "description": "Where a document opens when a card is clicked. `beside` keeps the board visible."
        },
        "markdownKanban.maxFiles": {
          "type": "number",
          "default": 3000,
          "minimum": 50,
          "description": "Upper bound on the number of Markdown files scanned per workspace folder."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs --minify",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "typecheck:webview": "tsc -p tsconfig.webview.json",
    "build:tests": "node esbuild.mjs --tests",
    "test": "node esbuild.mjs --tests && node test/run-tests.mjs"
  },
  "dependencies": {
    "globby": "^14.1.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
